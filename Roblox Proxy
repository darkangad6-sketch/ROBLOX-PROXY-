// Roblox Proxy Server Script
// Standard HTTP Proxy for Roblox API Requests

const express = require('express');
const axios = require('axios');
const app = express();

const PORT = process.env.PORT || 3000;

app.use(express.json());

// Basic logging middleware
app.use((req, res, next) => {
    console.log(`[${new Date().toISOString()}] ${req.method} request to ${req.url}`);
    next();
});

// Proxy route handler
app.use('/proxy', async (req, res) => {
    const targetUrl = req.query.url;

    if (!targetUrl) {
        return res.status(400).json({ error: 'Missing target URL parameter (?url=...)' });
    }

    try {
        const response = await axios({
            method: req.method,
            url: targetUrl,
            data: req.body,
            headers: {
                'User-Agent': 'Roblox-Proxy-Server/1.0',
                'Content-Type': 'application/json'
            }
        });

        res.status(response.status).json(response.data);
    } catch (error) {
        if (error.response) {
            res.status(error.response.status).json(error.response.data);
        } else {
            res.status(500).json({ error: 'Proxy request failed', details: error.message });
        }
    }
});

// Health check endpoint
app.get('/', (req, res) => {
    res.send('Roblox Proxy Server is running.');
});

app.listen(PORT, () => {
    console.log(`Server running on port ${PORT}`);
});
